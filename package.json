{
  "name": "bitbones",
  "version": "0.1.0",
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "bare bones gui client for bitsocial",
  "type": "module",
  "author": "Bitsocial Forge",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "yarn sync:lists && node scripts/start-dev.js",
    "start:preview": "node scripts/start-preview.js",
    "dev": "yarn sync:lists && vite",
    "build": "yarn sync:lists && vite build",
    "sync:lists": "node scripts/sync-default-lists.js",
    "lint": "oxlint --config oxlintrc.json src",
    "prettier": "oxfmt src/**/*.{ts,tsx} electron/**/*.js scripts/**/*.{js,mjs}",
    "knip": "knip --production --include dependencies,unlisted,binaries --no-progress",
    "knip:full": "knip --no-progress --no-exit-code",
    "doctor": "react-doctor . -y",
    "doctor:score": "react-doctor . --score -y",
    "doctor:verbose": "react-doctor . --verbose -y",
    "retest:quality": "yarn build && yarn lint && yarn type-check && yarn knip && yarn doctor --blocking none",
    "ai-workflow:check": "node scripts/validate-ai-workflow.mjs",
    "llms:generate": "node scripts/generate-llms-files.mjs",
    "i18n:update": "node scripts/update-translations.js",
    "i18n:update:dry": "node scripts/update-translations.js --dry",
    "preview": "vite preview",
    "analyze-bundle": "cross-env GENERATE_SOURCEMAP=true vite build && npx source-map-explorer 'build/assets/*.js'",
    "electron": "yarn electron:before && electron-forge start",
    "electron:dev": "concurrently \"cross-env BROWSER=none PORTLESS=0 PORT=5173 yarn start\" \"wait-on http://localhost:5173 && yarn electron\"",
    "electron:package": "yarn build && yarn electron:prepare-package && electron-forge package",
    "electron:make": "yarn build && yarn electron:prepare-package && electron-forge make",
    "electron:make:linux": "yarn build && yarn electron:prepare-package && electron-forge make --platform=linux",
    "electron:make:windows": "yarn build && yarn electron:prepare-package && electron-forge make --platform=win32",
    "electron:make:mac": "yarn build && yarn electron:prepare-package && electron-forge make --platform=darwin",
    "electron:prepare-package": "yarn electron:rebuild-native && yarn electron:verify-native",
    "electron:rebuild-native": "electron-rebuild -f -o better-sqlite3",
    "electron:verify-native": "node scripts/verify-electron-native-modules.js",
    "electron:before": "yarn electron:before:delete-data",
    "electron:before:delete-data": "node scripts/clear-local-pkc-data.mjs",
    "android:build:icons": "cordova-res android --skip-config --copy --resources /tmp/bitbones-android-icons --icon-source ./android/icons/icon.png --splash-source ./android/icons/splash.png --icon-foreground-source ./android/icons/icon-foreground.png --icon-background-source '#000000'",
    "changelog": "conventional-changelog --preset angular --infile CHANGELOG.md --same-file --release-count 0",
    "postinstall": "node scripts/patch-capacitor-cli-tar.cjs",
    "type-check": "tsc --noEmit",
    "ai-workflow:sync": "node scripts/sync-ai-workflow.mjs",
    "ai-workflow:test": "node --test scripts/__tests__/ai-workflow.node-test.mjs scripts/__tests__/agent-hooks.node-test.mjs"
  },
  "dependencies": {
    "@bitsocial/bitsocial-react-hooks": "0.1.39",
    "@bitsocial/bso-resolver": "0.0.10",
    "@capacitor/app": "7.0.1",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@floating-ui/react": "0.26.1",
    "@pkcprotocol/pkc-js": "0.0.85",
    "electron-context-menu": "3.3.0",
    "electron-is-dev": "2.0.0",
    "env-paths": "3.0.0",
    "ext-name": "5.0.0",
    "fs-extra": "11.3.0",
    "http-proxy": "1.18.1",
    "i18next": "25.10.9",
    "i18next-browser-languagedetector": "7.1.0",
    "i18next-http-backend": "3.0.5",
    "immer": "11.1.18",
    "javascript-time-ago": "2.6.4",
    "json-stringify-pretty-compact": "4.0.0",
    "kubo": "0.39.0",
    "memoizee": "0.4.17",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "16.6.6",
    "react-router-dom": "7.18.2",
    "react-virtuoso": "4.18.5",
    "tcp-port-used": "1.0.2",
    "zustand": "4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "7.4.5",
    "@capacitor/cli": "7.4.5",
    "@capacitor/core": "7.4.5",
    "@electron-forge/cli": "7.8.0",
    "@electron-forge/maker-dmg": "7.8.0",
    "@electron-forge/maker-squirrel": "7.8.0",
    "@electron-forge/maker-zip": "7.8.0",
    "@electron/rebuild": "3.7.2",
    "@reforged/maker-appimage": "5.1.1",
    "@types/memoizee": "0.4.12",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "8.0.1",
    "conventional-changelog-cli": "4.1.0",
    "cordova-res": "0.15.4",
    "cross-env": "7.0.3",
    "cross-spawn": "7.0.6",
    "cz-conventional-changelog": "3.3.0",
    "electron": "39.8.10",
    "element-source": "0.0.4",
    "glob": "10.5.0",
    "husky": "4.3.8",
    "js-yaml": "4.3.1",
    "knip": "6.17.0",
    "lint-staged": "12.3.8",
    "oxfmt": "0.20.0",
    "oxlint": "1.35.0",
    "playwright": "1.56.1",
    "react-doctor": "0.9.12",
    "react-grab": "0.2.0",
    "react-scan": "0.5.7",
    "smol-toml": "1.6.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-node-polyfills": "0.28.0",
    "vite-plugin-pwa": "1.3.0",
    "wait-on": "9.0.3"
  },
  "optionalDependencies": {
    "portless": "0.15.5"
  },
  "resolutions": {
    "@pkcprotocol/pkc-js": "0.0.85",
    "@libp2p/gossipsub": "16.0.4",
    "@libp2p/kad-dht": "16.2.6",
    "elliptic": "6.6.1",
    "protobufjs": "7.6.5",
    "@protobufjs/utf8": "1.1.1",
    "shell-quote": "1.9.0",
    "serialize-javascript": "7.0.5",
    "node-forge": "1.4.0",
    "@xmldom/xmldom": "0.8.15",
    "ws": "8.21.0",
    "undici@npm:^6.21.2": "6.28.0",
    "undici@npm:6.23.0": "6.28.0",
    "undici@npm:^7.16.0": "7.29.0",
    "undici@npm:^7.19.0": "7.29.0",
    "axios": "1.18.1",
    "axios@npm:^0.27.2": "0.30.2",
    "form-data": "4.0.6",
    "js-yaml": "4.3.1",
    "postcss": "8.5.23",
    "follow-redirects": "1.16.0",
    "nanoid@npm:^3.3.11": "3.3.18",
    "nanoid@npm:^5.0.7": "5.1.16",
    "nanoid@npm:^5.1.5": "5.1.16",
    "brace-expansion@npm:^1.1.7": "1.1.18",
    "brace-expansion@npm:^2.0.1": "2.1.4",
    "minimatch@npm:^3.0.4": "3.1.4",
    "minimatch@npm:^3.0.5": "3.1.4",
    "minimatch@npm:^3.1.1": "3.1.4",
    "minimatch@npm:^3.1.2": "3.1.4",
    "minimatch@npm:^5.0.1": "5.1.8",
    "minimatch@npm:^8.0.2": "8.0.5",
    "minimatch@npm:^9.0.3": "9.0.7",
    "ajv@npm:^8.0.0": "8.18.0",
    "ajv@npm:^8.6.0": "8.18.0",
    "ajv@npm:^8.9.0": "8.18.0",
    "ajv@npm:^8.11.0": "8.18.0",
    "fast-uri": "3.1.6",
    "ip-address": "10.3.1",
    "bn.js@npm:^4.0.0": "4.12.3",
    "bn.js@npm:^4.1.0": "4.12.3",
    "bn.js@npm:^4.11.9": "4.12.3",
    "bn.js@npm:^5.2.0": "5.2.3",
    "bn.js@npm:^5.2.1": "5.2.3",
    "lodash": "4.18.0",
    "tmp": "0.2.7",
    "jose": "4.15.9",
    "sharp": "0.35.3",
    "cacache": "19.0.1",
    "glob": "10.5.0",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@babel/core": "7.29.6",
    "@tootallnate/once": "3.0.1",
    "rollup": "2.80.0",
    "esbuild@npm:^0.25.0": "0.28.1",
    "yaml@npm:^1.10.0": "1.10.3",
    "yaml@npm:^1.10.2": "1.10.3",
    "uuid@npm:^8.3.2": "11.1.1",
    "uuid@npm:11.1.0": "11.1.1",
    "use-sync-external-store": "1.6.0",
    "@electron/asar": "4.0.1",
    "yauzl": "3.4.0",
    "qs": "6.16.0",
    "baseline-browser-mapping": "2.9.11",
    "vite": "8.2.2",
    "tar": "7.5.22",
    "undici@npm:7.24.7": "7.29.0",
    "uuid@npm:13.0.0": "13.0.1"
  },
  "main": "electron/main.js",
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "oxfmt"
    ],
    "{electron,scripts}/**/*.{js,mjs}": [
      "oxfmt"
    ]
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && cz --hook || true",
      "pre-commit": "lint-staged"
    }
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
