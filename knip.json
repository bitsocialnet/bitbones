{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/main.jsx", "electron/main.js", "electron/preload.js", "scripts/*.js", "forge.config.js", "vite.config.js"],
  "project": ["src/**/*.{js,jsx}", "electron/**/*.js", "scripts/**/*.js"],
  "ignore": [
    "src/components/feed-post-lazy-example/**",
    "src/hooks/use-is-mounted.js"
  ],
  "ignoreDependencies": [
    "kubo",
    "@electron-forge/maker-dmg",
    "@electron-forge/maker-squirrel",
    "@electron-forge/maker-zip",
    "@reforged/maker-appimage",
    "@release-it/conventional-changelog",
    "cz-conventional-changelog"
  ],
  "ignoreBinaries": ["source-map-explorer", "cz", "taskkill"]
}
